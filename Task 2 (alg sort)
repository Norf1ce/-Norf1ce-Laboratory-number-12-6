#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    printf("Введіть кількість елементів n: ");
    if (scanf("%d", &n) != 1 || n <= 0) return 1;

    double *original = (double *)malloc(n * sizeof(double));
    double *sorted = (double *)malloc(n * sizeof(double));

    if (original == NULL || sorted == NULL) return 1;

    printf("Введіть %d дійсних чисел:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%lf", &original[i]);
        sorted[i] = original[i];
    }

    for (int i = 1; i < n; i++) {
        double key = sorted[i];
        int j = i - 1;
        while (j >= 0 && sorted[j] < key) {
            sorted[j + 1] = sorted[j];
            j = j - 1;
        }
        sorted[j + 1] = key;
    }

    int count = 0;
    for (int i = 0; i < n; i++) {
        if (original[i] == sorted[i]) {
            count++;
        }
    }

    printf("\nВідсортована послідовність: ");
    for (int i = 0; i < n; i++) {
        printf("%.2lf ", sorted[i]);
    }
    printf("\nКількість елементів на своїх місцях: %d\n", count);

    free(original);
    free(sorted);

    return 0;
}
